<?xml version="1.0" encoding="UTF-8"?>
<mujoco model="interactive_step_trash_can">
  <!-- Source OBJ is Y-up; this root frame maps its Y axis to MuJoCo Z-up. -->
  <compiler angle="radian" autolimits="true" coordinate="local"/>
  <option timestep="0.002" gravity="0 0 -9.81" iterations="80" solver="Newton"/>
  <size njmax="2000" nconmax="400"/>

  <asset>
    <mesh name="mesh_root_0" file="meshes/root_0.obj"/>
    <mesh name="mesh_root_1" file="meshes/root_1.obj"/>
    <mesh name="mesh_root_2" file="meshes/root_2.obj"/>
    <mesh name="mesh_root_3" file="meshes/root_3.obj"/>
    <mesh name="mesh_root_4" file="meshes/root_4.obj"/>
    <texture name="trash_silver_tex" type="2d" file="textures/trash_silver_brushed.png"/>
    <!-- Color and grain come directly from the supplied brushed-silver image. -->
    <material name="trash_silver_mat" texture="trash_silver_tex"
              rgba="0.78 0.74 0.68 1" metallic="0.12" roughness="0.42"
              specular="0.45" shininess="0.72" reflectance="0.05"
              texuniform="false" texrepeat="1 1"/>
  </asset>

  <worldbody>
    <body name="trash_can" quat="0.70710678 0.70710678 0 0">
      <body name="bin">
        <!-- Fixed shell and the small fixed hardware pieces. -->
        <geom name="bin_shell_visual" type="mesh" mesh="mesh_root_0" material="trash_silver_mat"
              group="1" contype="0" conaffinity="0" mass="0"/>
        <!-- Hollow primitive collision keeps the opening usable for dropped objects. -->
        <geom name="bin_left_wall_collision" type="box" pos="-0.4125 0.628 0.08225"
              size="0.025 0.588 0.35425" group="3" mass="0"
              contype="1" conaffinity="1" condim="3" friction="0.8 0.03 0.01" rgba="0 0 0 0"/>
        <geom name="bin_right_wall_collision" type="box" pos="0.4125 0.628 0.08225"
              size="0.025 0.588 0.35425" group="3" mass="0"
              contype="1" conaffinity="1" condim="3" friction="0.8 0.03 0.01" rgba="0 0 0 0"/>
        <geom name="bin_front_wall_collision" type="box" pos="0 0.628 -0.247"
              size="0.3875 0.588 0.025" group="3" mass="0"
              contype="1" conaffinity="1" condim="3" friction="0.8 0.03 0.01" rgba="0 0 0 0"/>
        <geom name="bin_back_wall_collision" type="box" pos="0 0.628 0.4115"
              size="0.3875 0.588 0.025" group="3" mass="0"
              contype="1" conaffinity="1" condim="3" friction="0.8 0.03 0.01" rgba="0 0 0 0"/>
        <geom name="bin_bottom_collision" type="box" pos="0 0.065 0.08225"
              size="0.4375 0.025 0.35425" group="3" mass="0"
              contype="1" conaffinity="1" condim="3" friction="0.8 0.03 0.01" rgba="0 0 0 0"/>
        <geom name="bin_base_visual" type="mesh" mesh="mesh_root_2" material="trash_silver_mat"
              group="1" contype="0" conaffinity="0" mass="0"/>
        <geom name="bin_base_collision" type="mesh" mesh="mesh_root_2"
              group="3" contype="1" conaffinity="1" condim="3" friction="0.8 0.03 0.01"
              rgba="0 0 0 0"/>
        <geom name="lid_hinge_hardware" type="mesh" mesh="mesh_root_3" material="trash_silver_mat"
              group="1" contype="0" conaffinity="0" mass="0"/>
      </body>

      <!-- OBJ coordinates: lid hinge is near (0, 1.205, -0.31). The source
           scan has the lid standing open and slightly crowned, so install its
           local frame at 105 degrees to make q=0 sit flush on the rim. -->
      <body name="lid" pos="0 1.205 -0.310" quat="0.60876143 0.79335334 0 0" gravcomp="1">
        <joint name="lid_hinge_joint" type="hinge" axis="-1 0 0"
               range="0 1.3962634" limited="true" damping="0.004"
               stiffness="0.04" springref="0" armature="0.0002"/>
        <geom name="lid_mesh_visual" type="mesh" mesh="mesh_root_1" pos="0 0 0"
              material="trash_silver_mat" group="1" contype="0" conaffinity="0" mass="0"/>
        <geom name="lid_mesh_collision" type="mesh" mesh="mesh_root_1" pos="0 0 0"
              group="3" mass="0.12" contype="1" conaffinity="1"
              condim="3" friction="0.8 0.03 0.01" rgba="0 0 0 0"/>
      </body>

      <!-- OBJ coordinates: pedal hinge is near (0, 0.075, 0.455). -->
      <!-- Lift the pedal 2 cm in source Y (1 cm after the task scale) so its
           full ten-degree travel clears the ground plane. -->
      <body name="pedal" pos="0 0.095 0.455" gravcomp="1">
        <joint name="pedal_hinge_joint" type="hinge" axis="-1 0 0"
               range="-0.17453293 0" limited="true" damping="0.005"
               stiffness="0.005" springref="0" armature="0.0001"/>
        <geom name="pedal_mesh_visual" type="mesh" mesh="mesh_root_4" pos="0 -0.075 -0.455"
              material="trash_silver_mat" group="1" contype="0" conaffinity="0" mass="0"/>
        <!-- Axis-aligned box matching the visual pedal mesh bounds. -->
        <geom name="pedal_mesh_collision" type="box"
              pos="-0.000784 -0.0134095 -0.0059935" size="0.17574 0.0515675 0.1124085"
              group="3" mass="0.05" contype="1" conaffinity="1"
              condim="4" friction="1.2 0.04 0.02" rgba="0 0 0 0"/>
        <site name="foot_press_site" pos="0 0.015 0.12" size="0.018"
              rgba="0.95 0.75 0.05 0.45"/>
      </body>
    </body>
  </worldbody>

  <!-- Ten degrees of pedal travel opens the lid through its full 80-degree range. -->
  <equality>
    <joint name="pedal_lid_linkage" joint1="lid_hinge_joint" joint2="pedal_hinge_joint"
           polycoef="0 -8 0 0 0" solref="0.004 0.7" solimp="0.95 0.99 0.001"/>
  </equality>
  <contact>
    <!-- The pieces are mechanically connected; avoid self-collision jitter. -->
    <exclude body1="lid" body2="bin"/>
    <exclude body1="pedal" body2="bin"/>
  </contact>
</mujoco>
